<?php
// Включаем отображение всех ошибок для отладки
ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);

// Начинаем сессию
session_start();

// Проверка авторизации
if (!isset($_SESSION['user_id'])) {
    die(json_encode(['success' => false, 'error' => 'Не авторизован']));
}

// Проверяем, что файл загружен
if (!isset($_FILES['actsFile']) || $_FILES['actsFile']['error'] !== UPLOAD_ERR_OK) {
    $error_msg = isset($_FILES['actsFile']) ? 'Ошибка загрузки: ' . $_FILES['actsFile']['error'] : 'Файл не передан';
    die(json_encode(['success' => false, 'error' => $error_msg]));
}

// Проверяем наличие автозагрузчика
if (!file_exists(__DIR__ . '/../vendor/autoload.php')) {
    die(json_encode(['success' => false, 'error' => 'Библиотека PhpSpreadsheet не установлена']));
}

require_once __DIR__ . '/../vendor/autoload.php';

$file = $_FILES['actsFile'];
$file_ext = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));

$allowed_extensions = ['xlsx', 'xls'];
if (!in_array($file_ext, $allowed_extensions)) {
    die(json_encode(['success' => false, 'error' => 'Неподдерживаемый формат. Поддерживаются: .xlsx, .xls']));
}

try {
    $inputFileType = \PhpOffice\PhpSpreadsheet\IOFactory::identify($file['tmp_name']);
    $reader = \PhpOffice\PhpSpreadsheet\IOFactory::createReader($inputFileType);
    $spreadsheet = $reader->load($file['tmp_name']);
    
    $sheet = $spreadsheet->getSheetByName('Пункты актов');
    if (!$sheet) {
        $sheet = $spreadsheet->getActiveSheet();
    }
    
    $rows = $sheet->toArray();
    
    if (count($rows) < 2) {
        die(json_encode(['success' => false, 'error' => 'Файл не содержит данных']));
    }
    
    $headers = array_map('trim', $rows[0]);
    
    // Список нужных столбцов
    $requiredColumns = [
        'Номер акта',
        'Дата акта',
        'Период оказания услуг по акту',
        'Id конечного договора',
        'Номер конечного договора',
        'Дата конечного договора',
        'ИНН заказчика КД',
        'Сумма без НДС',
        'Ставка НДС',
        'Сумма НДС',
        'Сумма с НДС',
        'ID пункта акта',
        'Общее число фактических показов',
        'Общее число показов по акту',
        'Общая сумма без НДС статистики',
        'Общая сумма НДС статистики',
        'Общая сумма с НДС статистики'
    ];
    
    // Ищем индексы нужных столбцов
    $columnsMap = [];
    foreach ($requiredColumns as $requiredCol) {
        $columnsMap[$requiredCol] = null;
    }
    
    // Ищем соответствие заголовков
    foreach ($headers as $columnIndex => $header) {
        $header = trim($header);
        if (empty($header)) continue;
        
        $headerLower = mb_strtolower($header);
        
        foreach ($requiredColumns as $requiredCol) {
            $requiredLower = mb_strtolower($requiredCol);
            
            if (strpos($headerLower, $requiredLower) !== false || strpos($requiredLower, $headerLower) !== false) {
                $columnsMap[$requiredCol] = (int)$columnIndex;
                break;
            }
        }
    }
    
    // Проверяем, какие столбцы найдены
    $foundColumns = array_filter($columnsMap, function($v) { return $v !== null; });
    $missingColumns = array_filter($columnsMap, function($v) { return $v === null; });
    
    if (empty($foundColumns)) {
        die(json_encode([
            'success' => false,
            'error' => 'Не найдено ни одного подходящего столбца. Проверьте названия столбцов в файле.',
            'headers' => $headers
        ]));
    }
    
    // Парсим данные
    $data = [];
    for ($i = 1; $i < count($rows); $i++) {
        $row = $rows[$i];
        $rowData = [];
        
        foreach ($columnsMap as $key => $columnIndex) {
            if (is_int($columnIndex) && $columnIndex >= 0 && isset($row[$columnIndex])) {
                $value = $row[$columnIndex];
                
                if (is_numeric($value) && $value > 0) {
                    try {
                        $dateTime = \PhpOffice\PhpSpreadsheet\Shared\Date::excelToDateTimeObject($value);
                        if ($dateTime) {
                            $value = $dateTime->format('d.m.Y');
                        }
                    } catch (Exception $e) {
                        // Не дата
                    }
                }
                
                if (is_numeric($value) && !is_int($value)) {
                    $value = number_format($value, 2, '.', ' ');
                }
                
                $rowData[$key] = $value;
            } else {
                $rowData[$key] = '';
            }
        }
        
        if (!empty($rowData['Номер акта'])) {
            $data[] = $rowData;
        }
    }
    
    if (empty($data)) {
        die(json_encode([
            'success' => false,
            'error' => 'Не найдено данных. Проверьте, что в файле есть строки с заполненным столбцом "Номер акта"',
            'found_columns' => array_keys($foundColumns),
            'total_rows' => count($rows)
        ]));
    }
    
    $_SESSION['acts_data'] = $data;
    $_SESSION['uploaded_file_name'] = $file['name'];
    
    echo json_encode([
        'success' => true,
        'count' => count($data),
        'found_columns' => array_keys($foundColumns),
        'missing_columns' => array_keys($missingColumns),
        'message' => 'Файл успешно обработан. Найдено записей: ' . count($data)
    ]);
    
} catch (Exception $e) {
    echo json_encode([
        'success' => false,
        'error' => 'Ошибка при обработке файла: ' . $e->getMessage()
    ]);
}
?>